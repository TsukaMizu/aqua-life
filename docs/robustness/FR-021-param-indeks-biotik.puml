@startuml FR-021-ParamIndeksBiotik
' FR-021: Sistem memungkinkan penambahan, pembaruan, dan penghapusan parameter indeks biotik.
' Aktor: Operator, Admin

skinparam handwritten false
skinparam defaultFontSize 12
skinparam roundcorner 8

title FR-021 – CRUD Parameter Indeks Biotik\n(Aktor: Operator / Admin)

actor "Operator/Admin" as U
boundary "KelolaBobotPage\n(Inertia View)" as UI
control "KelolaBobotController\n(Operator/Admin)" as Ctrl
entity "BioticIndexParameter" as BIPE

' Tambah
U --> UI : 1. Submit form tambah (POST /kelola-bobot/biotic-index)
UI --> Ctrl : 2. storeBioticIndex(Request)
Ctrl --> Ctrl : 3. Validasi input (name, initial_value, final_value, weight)
Ctrl --> BIPE : 4. BioticIndexParameter::create({name, initial_value,\nfinal_value, weight})
Ctrl --> UI : 5. redirect()->back() + flash success

' Perbarui
U --> UI : 6. Submit form edit (PUT /kelola-bobot/biotic-index/{parameter})
UI --> Ctrl : 7. updateBioticIndex($parameter, Request)
Ctrl --> Ctrl : 8. Validasi input
Ctrl --> BIPE : 9. $parameter->update({name, initial_value, final_value, weight})
Ctrl --> UI : 10. redirect()->back() + flash success

' Hapus
U --> UI : 11. Konfirmasi hapus (DELETE /kelola-bobot/biotic-index/{parameter})
UI --> Ctrl : 12. destroyBioticIndex($parameter)
Ctrl --> BIPE : 13. $parameter->delete()
Ctrl --> UI : 14. redirect()->back() + flash success

@enduml
